diff --git a/rust/kernel/src/kernel/resource_access.rs b/rust/kernel/src/kernel/resource_access.rs
new file mode 100644
index 000000000..966309ede
--- /dev/null
+++ b/rust/kernel/src/kernel/resource_access.rs
@@ -0,0 +1,205 @@
+//! Result-preserving admission for APIs whose legacy shape carries no context.
+use super::{Kernel, KernelError, OperationContext, StatResult};
+use crate::abc::object_store::StorageError;
+use crate::core::vfs_router::RouteResult;
+use crate::dispatch::Permission;
+use crate::kernel::syscall::ReaddirOpts;
+
+pub(super) fn storage_error(error: StorageError) -> KernelError {
+    match error {
+        StorageError::NotFound(path) => KernelError::FileNotFound(path),
+        StorageError::IOError(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            KernelError::FileNotFound(error.to_string())
+        }
+        StorageError::IOError(error) if error.kind() == std::io::ErrorKind::PermissionDenied => {
+            KernelError::PermissionDenied(error.to_string())
+        }
+        StorageError::IOError(error) => KernelError::IOError(error.to_string()),
+        error => KernelError::BackendError(format!("{error:?}")),
+    }
+}
+
+impl Kernel {
+    pub(crate) fn check_resource_path(
+        &self,
+        path: &str,
+        route: Option<&RouteResult>,
+        ctx: &OperationContext,
+        follow: bool,
+    ) -> Result<(), KernelError> {
+        let Some(guard) = &ctx.resource_guard else {
+            return Ok(());
+        };
+        guard.check(path).map_err(KernelError::PermissionDenied)?;
+        let Some(route) = route else {
+            return Ok(());
+        };
+        let Some(backend) = &route.backend else {
+            if route.target_zone_id.is_some() {
+                return Err(KernelError::PermissionDenied(
+                    "scoped peer route is unsupported".into(),
+                ));
+            }
+            return Ok(());
+        };
+        let actual =
+            backend
+                .scoped_path(&route.backend_path, follow)
+                .map_err(|error| match error {
+                    StorageError::NotSupported(_) => KernelError::PermissionDenied(
+                        "scoped backend admission is unsupported".into(),
+                    ),
+                    error => storage_error(error),
+                })?;
+        if let Some(actual) = actual {
+            let actual = crate::core::vfs_router::zone_to_global(
+                &route.mount_point,
+                &format!("/{}", actual.trim_start_matches('/')),
+            );
+            guard
+                .check(&actual)
+                .map_err(KernelError::PermissionDenied)?;
+        }
+        Ok(())
+    }
+
+    pub fn scoped_stat(
+        &self,
+        path: &str,
+        ctx: &OperationContext,
+    ) -> Result<Option<StatResult>, KernelError> {
+        self.scoped_stat_for(path, ctx, Permission::Read)
+    }
+
+    pub fn scoped_stat_for(
+        &self,
+        path: &str,
+        ctx: &OperationContext,
+        permission: Permission,
+    ) -> Result<Option<StatResult>, KernelError> {
+        let route = self.vfs_router.route(path, &ctx.zone_id);
+        self.check_permission_with_route(path, route.as_ref(), permission, ctx)?;
+        self.check_resource_path(path, route.as_ref(), ctx, true)?;
+        self.sys_stat_result(path, &ctx.zone_id, ctx.resource_guard.is_some())
+    }
+
+    pub fn scoped_readdir(
+        &self,
+        path: &str,
+        ctx: &OperationContext,
+        opts: ReaddirOpts,
+    ) -> Result<Vec<(String, u8)>, KernelError> {
+        if ctx.resource_guard.is_none() {
+            self.check_permission(path, Permission::Read, ctx)?;
+            let entries = self.sys_readdir_checked(path, &ctx.zone_id, false, opts)?;
+            let mut visible = Vec::new();
+            for entry in entries {
+                match self.check_permission(&entry.0, Permission::Read, ctx) {
+                    Ok(()) => visible.push(entry),
+                    Err(KernelError::PermissionDenied(_)) => {}
+                    Err(error) => return Err(error),
+                }
+            }
+            return Ok(visible);
+        }
+        let path = if path != "/" {
+            path.trim_end_matches('/')
+        } else {
+            path
+        };
+        let stat = self
+            .scoped_stat(path, ctx)?
+            .ok_or_else(|| KernelError::FileNotFound(path.into()))?;
+        if !stat.is_directory {
+            return Err(KernelError::InvalidPath(format!("not a directory: {path}")));
+        }
+        let route = self
+            .vfs_router
+            .route(path, &ctx.zone_id)
+            .ok_or_else(|| KernelError::FileNotFound(path.into()))?;
+        let mut seen = std::collections::BTreeMap::new();
+        self.scan_mount_into_admitted(&route, path, opts.recursive, &mut seen, Some(ctx))?;
+        if opts.recursive {
+            for child in self.vfs_router.child_mounts_under(path, &ctx.zone_id) {
+                let child_route = self.vfs_router.route(&child, &ctx.zone_id);
+                match self
+                    .check_permission_with_route(
+                        &child,
+                        child_route.as_ref(),
+                        Permission::Read,
+                        ctx,
+                    )
+                    .and_then(|_| self.check_resource_path(&child, child_route.as_ref(), ctx, true))
+                {
+                    Ok(()) => {}
+                    Err(KernelError::PermissionDenied(_)) => continue,
+                    Err(error) => return Err(error),
+                }
+                if let Some(route) = child_route {
+                    self.scan_mount_into_admitted(&route, &child, true, &mut seen, Some(ctx))?;
+                }
+            }
+        }
+        let mut visible = Vec::new();
+        for (path, (kind, zone)) in seen {
+            if ctx.zone_id != contracts::ROOT_ZONE_ID
+                && zone
+                    .as_deref()
+                    .is_some_and(|zone| zone != ctx.zone_id && zone != contracts::ROOT_ZONE_ID)
+            {
+                continue;
+            }
+            match self.check_permission(&path, Permission::Read, ctx) {
+                Ok(()) => visible.push((path, kind)),
+                Err(KernelError::PermissionDenied(_)) => {}
+                Err(error) => return Err(error),
+            }
+        }
+        if let Some(limit) = opts.limit {
+            visible.truncate(limit);
+        }
+        Ok(visible)
+    }
+
+    /// No ancestor is read or created implicitly by this scoped convenience.
+    pub fn scoped_mkdir_all(&self, path: &str, ctx: &OperationContext) -> Result<(), KernelError> {
+        self.check_permission(path, Permission::Write, ctx)?;
+        if ctx.resource_guard.is_none() {
+            self.mkdir(path, ctx, true, true)?;
+            return Ok(());
+        }
+        let guard = ctx.resource_guard.as_ref().unwrap();
+        let mut prefix = String::new();
+        let mut started = guard.check("/").is_ok();
+        for part in path.split('/').filter(|part| !part.is_empty()) {
+            prefix.push('/');
+            prefix.push_str(part);
+            if guard.check(&prefix).is_err() {
+                if started {
+                    return Err(KernelError::PermissionDenied(prefix));
+                }
+                continue;
+            }
+            let route = self.vfs_router.route(&prefix, &ctx.zone_id);
+            self.check_resource_path(&prefix, route.as_ref(), ctx, true)?;
+            self.check_permission(&prefix, Permission::Write, ctx)?;
+            if !started {
+                if !self
+                    .scoped_stat_for(&prefix, ctx, Permission::Write)?
+                    .is_some_and(|stat| stat.is_directory)
+                {
