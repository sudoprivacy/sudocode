FROM docker:29.4.3-cli@sha256:51e23845f5caff1e688a2fae003b0c69d635c9200ad544731db1593731df1d3a AS docker-client

FROM rust:1.100.0@sha256:e19840879045c951c905d0eaa9887f3439c62000e429963371b376bac8d38c31

COPY --from=docker-client /usr/local/bin/docker /usr/local/bin/docker
RUN docker --version

RUN nice -n 10 apt-get update \
 && nice -n 10 apt-get install -y --no-install-recommends python3-psutil \
 && rm -rf /var/lib/apt/lists/*

RUN nice -n 10 rustup component add rustfmt clippy \
 && cargo fmt --version \
 && cargo clippy --version


# Cache the VFS fixture's independent Rust compiler in this image layer.
COPY vfs-rust-version /opt/vfs-rust-version
RUN nice -n 10 rustup toolchain install "$(cat /opt/vfs-rust-version)" --profile minimal --no-self-update
RUN --network=none version="$(cat /opt/vfs-rust-version)" \
 && rustup run "$version" rustc -vV \
 && rustup run "$version" cargo --version

ENV CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0
COPY nextest_seed.py /opt/nextest_seed.py
RUN python3 /opt/nextest_seed.py --verify-cache
COPY compiler-objects /opt/compiler-objects
RUN mkdir -p /opt/compiler-objects/src \
 && printf 'fn main() {}\n' > /opt/compiler-objects/src/main.rs \
 && nice -n 10 cargo fetch --locked --manifest-path /opt/compiler-objects/Cargo.toml
COPY compiler_cache.py compiler_seed.py /opt/
RUN python3 /opt/compiler_seed.py --verify-cache
COPY guard.py /opt/acceptance-guard.py
# Compiler discovery may probe optional toolchains. Only use those baked into the image.
ENV SCODE_ACCEPTANCE_BUILD_JOBS=1 RUSTUP_AUTO_INSTALL=0
ENTRYPOINT ["python3", "/opt/acceptance-guard.py"]
