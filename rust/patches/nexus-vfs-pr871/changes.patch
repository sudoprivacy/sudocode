diff --git a/rust/backends/src/storage/scoped_local.rs b/rust/backends/src/storage/scoped_local.rs
new file mode 100644
index 000000000..9c7f9a9e6
--- /dev/null
+++ b/rust/backends/src/storage/scoped_local.rs
@@ -0,0 +1,68 @@
+//! Stable native path resolution for request-scoped resource admission.
+use kernel::abc::object_store::StorageError;
+use std::path::{Path, PathBuf};
+
+pub(super) fn scoped_path(root: &Path, path: &str, follow: bool) -> Result<String, StorageError> {
+    let root = root.canonicalize().map_err(StorageError::IOError)?;
+    let path = Path::new(path.trim_start_matches('/'));
+    if path
+        .components()
+        .any(|part| !matches!(part, std::path::Component::Normal(_)))
+    {
+        return Err(StorageError::IOError(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "invalid scoped backend path",
+        )));
+    }
+    let physical = root.join(path);
+    let (start, mut suffix) = if follow {
+        (physical.clone(), Vec::new())
+    } else {
+        (
+            physical.parent().unwrap_or(&root).to_path_buf(),
+            physical
+                .file_name()
+                .map(|name| vec![name.to_os_string()])
+                .unwrap_or_default(),
+        )
+    };
+    let mut current = start;
+    let resolved = loop {
+        match current.canonicalize() {
+            Ok(mut resolved) => {
+                for part in suffix.iter().rev() {
+                    resolved.push(part);
+                }
+                break resolved;
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                // A dangling link is an existing entry whose target is missing;
+                // treating it as a missing leaf would permit write-through escape.
+                if std::fs::symlink_metadata(&current)
+                    .is_ok_and(|metadata| metadata.file_type().is_symlink())
+                {
+                    return Err(StorageError::IOError(std::io::Error::new(
+                        std::io::ErrorKind::PermissionDenied,
+                        "unresolved scoped native link",
+                    )));
+                }
+                let Some(name) = current.file_name() else {
+                    return Err(StorageError::IOError(error));
+                };
+                suffix.push(name.to_os_string());
+                current = current
+                    .parent()
+                    .map(PathBuf::from)
+                    .ok_or(StorageError::IOError(error))?;
+            }
+            Err(error) => return Err(StorageError::IOError(error)),
+        }
+    };
+    let relative = resolved.strip_prefix(&root).map_err(|_| {
+        StorageError::IOError(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "scoped path escapes mount",
+        ))
+    })?;
+    Ok(relative.to_string_lossy().replace('\\', "/"))
+}
