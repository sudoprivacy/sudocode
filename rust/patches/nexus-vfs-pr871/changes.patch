@@ -0,0 +1,7 @@
+//! Optional request-local resource admission, independent of principal permissions.
+
+/// The host fixes the top-level resource intent when constructing this guard.
+/// Nested syscalls cannot relabel a read to acquire a different grant.
+pub trait ResourceGuard: std::fmt::Debug + Send + Sync {
+    fn check(&self, path: &str) -> Result<(), String>;
+}
