@@ -0,0 +1,288 @@
+//! One fail-closed protocol entry with server-owned compound-operation intent.
+use super::*;
+use contracts::resource_guard::ResourceGuard;
+use kernel::kernel::vfs_proto::{
+    scoped_fs_request::Operation, scoped_fs_response::Result as FsResult,
+};
+use sudo_contracts::{RuntimeResourceScope, Validate};
+
+#[derive(Debug)]
+struct ScopedGuard {
+    scope: RuntimeResourceScope,
+    capability: &'static str,
+}
+
+impl contracts::resource_guard::ResourceGuard for ScopedGuard {
+    fn check(&self, path: &str) -> Result<(), String> {
+        contracts::validate_zone_path(path).map_err(|error| error.to_string())?;
+        if self.scope.rules.iter().any(|rule| {
+            rule.capability == self.capability
+                && rule.resource_prefixes.iter().any(|prefix| {
+                    prefix == "/" || path == prefix || path.starts_with(&format!("{prefix}/"))
+                })
+        }) {
+            Ok(())
+        } else {
+            Err(format!("{path} is outside runtime scope"))
+        }
+    }
+}
+
+fn request<T>(value: T, ctx: &OperationContext) -> Request<T> {
+    let mut request = Request::new(value);
+    request
+        .extensions_mut()
+        .insert(AuthenticatedRequestContext(ctx.clone()));
+    request
+}
+
+fn compound_error(payload: Vec<u8>) -> WriteResponse {
+    WriteResponse {
+        is_error: true,
+        error_payload: payload,
+        ..Default::default()
+    }
+}
+
+impl VfsServiceImpl {
+    pub(super) async fn scoped_fs_request(
+        &self,
+        req: Request<ScopedFsRequest>,
+    ) -> Result<Response<ScopedFsResponse>, Status> {
+        let (mut ctx, req) = self.authenticate(req).await?;
+        if req.version != 1 {
+            return Err(Status::unimplemented(
+                "unsupported scoped filesystem protocol",
+            ));
+        }
+        let scope: RuntimeResourceScope = serde_json::from_slice(&req.resource_scope_json)
+            .map_err(|_| Status::permission_denied("invalid resource scope"))?;
+        scope
+            .validate()
+            .map_err(|_| Status::permission_denied("invalid resource scope"))?;
+        if scope.zone_id != ctx.zone_id {
+            return Err(Status::permission_denied(
+                "resource scope zone differs from authenticated zone",
+            ));
+        }
+        let op = req
+            .operation
+            .ok_or_else(|| Status::invalid_argument("missing scoped operation"))?;
+        let read = matches!(
+            &op,
+            Operation::Read(_)
+                | Operation::Stat(_)
+                | Operation::Readdir(_)
+                | Operation::StreamReadAt(_)
+        );
+        let capability = if read {
+            "zone.data.read"
+        } else {
+            "zone.data.write"
+        };
+        ctx.resource_guard = Some(Arc::new(ScopedGuard {
+            scope: scope.clone(),
+            capability,
+        }));
+        // Every nested handler receives only this authenticated, immutable context.
+        let result = match op {
+            Operation::Read(r) => FsResult::Read(self.read(request(r, &ctx)).await?.into_inner()),
+            Operation::Write(r) => {
+                FsResult::Write(self.write(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Stat(r) => {
+                if !r.zone_id.is_empty() && r.zone_id != ctx.zone_id {
+                    return Err(Status::permission_denied("cross-zone stat"));
+                }
+                FsResult::Stat(self.stat(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Readdir(r) => {
+                if r.recursive || r.from_peer || (!r.zone_id.is_empty() && r.zone_id != ctx.zone_id)
+                {
+                    return Err(Status::invalid_argument(
+                        "unsupported scoped enumeration mode",
+                    ));
+                }
+                FsResult::Readdir(self.readdir(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Setattr(r) => {
+                if !matches!(r.entry_type, 1 | 4 | 6)
+                    || (!r.zone_id.is_empty() && r.zone_id != ctx.zone_id)
+                    || r.content_id.is_some()
+                    || !r.backend_name.is_empty()
+                    || r.is_external
+                {
+                    return Err(Status::permission_denied("unsupported scoped setattr"));
+                }
+                if r.entry_type == 6 {
+                    let target = r
+                        .link_target
+                        .as_deref()
+                        .ok_or_else(|| Status::invalid_argument("missing link target"))?;
+                    ctx.resource_guard
+                        .as_ref()
+                        .unwrap()
+                        .check(target)
+                        .map_err(Status::permission_denied)?;
+                }
+                FsResult::Setattr(self.setattr(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Mkdir(r) => {
+                ScopedGuard {
+                    scope,
+                    capability: "zone.data.read",
+                }
+                .check(&r.path)
+                .map_err(Status::permission_denied)?;
+                FsResult::Mkdir(self.mkdir(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Delete(r) => {
+                if r.recursive {
+                    return Err(Status::invalid_argument(
+                        "recursive scoped deletion is unsupported",
+                    ));
+                }
+                FsResult::Delete(self.delete(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Lock(r) => FsResult::Lock(self.lock(request(r, &ctx)).await?.into_inner()),
+            Operation::Unlock(r) => {
+                if r.force {
+                    return Err(Status::permission_denied(
+                        "scoped force unlock is unsupported",
+                    ));
+                }
+                FsResult::Unlock(self.unlock(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::StreamWrite(r) => FsResult::StreamWrite(
+                self.stream_write_nowait(request(r, &ctx))
+                    .await?
+                    .into_inner(),
+            ),
+            Operation::StreamReadAt(r) => {
+                FsResult::StreamReadAt(self.stream_read_at(request(r, &ctx)).await?.into_inner())
+            }
+            Operation::Rename(r) => {
+                ctx.resource_guard
+                    .as_ref()
+                    .unwrap()
+                    .check(&r.from)
+                    .map_err(Status::permission_denied)?;
+                ctx.resource_guard
+                    .as_ref()
+                    .unwrap()
+                    .check(&r.to)
+                    .map_err(Status::permission_denied)?;
+                let read = self
+                    .read(request(
+                        ReadRequest {
+                            path: r.from.clone(),
+                            ..Default::default()
+                        },
+                        &ctx,
+                    ))
+                    .await?
+                    .into_inner();
+                if read.is_error {
+                    return Ok(Response::new(ScopedFsResponse {
+                        result: Some(FsResult::Rename(compound_error(read.error_payload))),
+                    }));
+                }
+                let write = self
+                    .write(request(
+                        WriteRequest {
+                            path: r.to,
+                            content: read.content,
+                            ..Default::default()
+                        },
+                        &ctx,
+                    ))
+                    .await?
+                    .into_inner();
+                if write.is_error {
+                    return Ok(Response::new(ScopedFsResponse {
+                        result: Some(FsResult::Rename(write)),
+                    }));
+                }
+                let deleted = self
+                    .delete(request(
+                        DeleteRequest {
+                            path: r.from,
+                            ..Default::default()
+                        },
+                        &ctx,
+                    ))
+                    .await?
+                    .into_inner();
+                if deleted.is_error {
+                    return Ok(Response::new(ScopedFsResponse {
+                        result: Some(FsResult::Rename(compound_error(deleted.error_payload))),
+                    }));
+                }
+                FsResult::Rename(write)
+            }
+            Operation::Append(r) => {
+                ScopedGuard {
+                    scope,
+                    capability: "zone.data.read",
+                }
+                .check(&r.path)
+                .map_err(Status::permission_denied)?;
+                // The client supplies the existing predicate's branch, never a resource intent.
+                if r.stream {
+                    let written = self
+                        .stream_write_nowait(request(
+                            StreamWriteRequest {
+                                path: r.path,
+                                data: r.content,
+                                ..Default::default()
+                            },
+                            &ctx,
+                        ))
+                        .await?
+                        .into_inner();
+                    FsResult::Append(if written.is_error {
+                        compound_error(written.error_payload)
+                    } else {
+                        WriteResponse::default()
+                    })
+                } else {
+                    let kernel = self.kernel.clone();
+                    let read_ctx = ctx.clone();
+                    let path = r.path.clone();
+                    let read = run_blocking(move || {
+                        KernelSyscall::sys_read(&*kernel, &path, &read_ctx, 0, 0)
+                    })
+                    .await?;
+                    let mut content = match read {
+                        Ok(read) => read.data.unwrap_or_default(),
+                        Err(KernelError::FileNotFound(_)) => Vec::new(),
+                        Err(error) => {
+                            let (code, message) = self.map_kernel_err(error);
+                            return Ok(Response::new(ScopedFsResponse {
+                                result: Some(FsResult::Append(compound_error(encode_rpc_error(
+                                    code, &message,
+                                )))),
+                            }));
+                        }
+                    };
+                    content.extend_from_slice(&r.content);
+                    FsResult::Append(
+                        self.write(request(
+                            WriteRequest {
+                                path: r.path,
+                                content,
+                                ..Default::default()
+                            },
+                            &ctx,
+                        ))
+                        .await?
+                        .into_inner(),
+                    )
+                }
+            }
+        };
+        Ok(Response::new(ScopedFsResponse {
+            result: Some(result),
+        }))
+    }
+}
