{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec/cache_usage_fixtures.schema.json",
  "title": "Synthetic cache usage fixtures",
  "description": "Proposed schema for synthetic usage snapshots and the totals a cache report must derive from them. Field names follow the Anthropic usage fields in spec/prompt_cache_observations.json.",
  "type": "object",
  "required": ["schema_version", "scope", "schema", "metrics_spec", "evidence_scope", "counting_rules", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"type": "string"},
    "schema": {"const": "spec/cache_usage_fixtures.schema.json"},
    "metrics_spec": {"const": "spec/cache_metrics.json"},
    "evidence_scope": {"type": "string"},
    "counting_rules": {
      "type": "object",
      "required": ["request_identity", "repeated_snapshots", "distinct_requests", "segments", "cache_efficiency"],
      "additionalProperties": false,
      "properties": {
        "request_identity": {"const": ["request_id", "request_started_ms", "context_segment"]},
        "repeated_snapshots": {"type": "string"},
        "distinct_requests": {"type": "string"},
        "segments": {"type": "string"},
        "cache_efficiency": {"type": "string"}
      }
    },
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "usage": {
      "type": "object",
      "description": "Cumulative usage reported for one request. input_tokens excludes cache reads and writes.",
      "required": ["input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"$ref": "#/$defs/count"},
        "cache_read_input_tokens": {"$ref": "#/$defs/count"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/count"},
        "output_tokens": {"$ref": "#/$defs/count"}
      }
    },
    "ttl": {"enum": [300, 3600]},
    "snapshot": {
      "type": "object",
      "description": "One usage observation. Several snapshots may share a request identity, and the last one is final.",
      "required": ["request_id", "request_started_ms", "response_started_ms", "response_completed_ms", "context_segment", "request_kind", "requested_ttls_seconds", "usage"],
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "description": "Synthetic correlation id. Maps to gateway_request_id in requests.jsonl."},
        "request_started_ms": {"$ref": "#/$defs/count"},
        "response_started_ms": {"$ref": "#/$defs/count"},
        "response_completed_ms": {"$ref": "#/$defs/count"},
        "context_segment": {"$ref": "#/$defs/count"},
        "request_kind": {"enum": ["session_request", "compaction"]},
        "requested_ttls_seconds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ttl"}, "description": "Client cache-marker TTLs on the final request. They do not establish the upstream TTL."},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "group_total": {
      "type": "object",
      "required": ["requests", "usage"],
      "properties": {
        "requests": {"$ref": "#/$defs/count"},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "expected": {
      "type": "object",
      "required": ["sessions", "requests", "duplicate_snapshots_ignored", "session_usage", "segments", "segment_boundaries", "cache_efficiency"],
      "additionalProperties": false,
      "properties": {
        "sessions": {"const": 1},
        "requests": {"$ref": "#/$defs/count", "description": "Distinct request identities."},
        "duplicate_snapshots_ignored": {"$ref": "#/$defs/count", "description": "Snapshots minus distinct request identities."},
        "session_usage": {"$ref": "#/$defs/usage", "description": "Final usage summed once per request across every segment."},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [{"$ref": "#/$defs/group_total"}],
            "required": ["context_segment"],
            "properties": {"context_segment": {"$ref": "#/$defs/count"}},
            "unevaluatedProperties": false
          }
        },
        "segment_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["after_request_id", "from_segment", "to_segment", "cause"],
            "additionalProperties": false,
            "properties": {
              "after_request_id": {"type": "string"},
              "from_segment": {"$ref": "#/$defs/count"},
              "to_segment": {"$ref": "#/$defs/count"},
              "cause": {"const": "compaction"}
            }
          }
        },
        "by_requested_ttl": {
          "type": "array",
          "items": {
            "allOf": [{"$ref": "#/$defs/group_total"}],
            "required": ["requested_ttl_seconds"],
            "properties": {"requested_ttl_seconds": {"$ref": "#/$defs/ttl"}},
            "unevaluatedProperties": false
          }
        },
        "cache_efficiency": {
          "type": "object",
          "required": ["read_share_pct", "write_share_pct", "reuse_pct"],
          "additionalProperties": false,
          "properties": {
            "read_share_pct": {"$ref": "#/$defs/percent"},
            "write_share_pct": {"$ref": "#/$defs/percent"},
            "reuse_pct": {"$ref": "#/$defs/percent"}
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "description", "session_id", "model", "snapshots", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "description": {"type": "string"},
        "session_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "ttl_transition": {
          "type": "object",
          "description": "A requested TTL change. Observations after it are supplied inputs, not a claim about any route.",
          "required": ["from_ttl_seconds", "to_ttl_seconds", "first_request_id", "upstream_ttl", "observations", "savings_claimed"],
          "additionalProperties": false,
          "properties": {
            "from_ttl_seconds": {"$ref": "#/$defs/ttl"},
            "to_ttl_seconds": {"$ref": "#/$defs/ttl"},
            "first_request_id": {"type": "string"},
            "upstream_ttl": {"const": "unknown"},
            "observations": {"const": "supplied"},
            "savings_claimed": {"const": false}
          }
        },
        "snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/snapshot"}},
        "expected": {"$ref": "#/$defs/expected"}
      }
    }
  }
}
